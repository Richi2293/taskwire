#!/usr/bin/env bash
set -euo pipefail

# Resolve the real location of this script, following symlinks (macOS has no readlink -f by default).
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ "$source" != /* ]] && source="$dir/$source"
done
root="$(cd -P "$(dirname "$source")/.." && pwd)"

exec node --disable-warning=ExperimentalWarning "$root/src/index.ts" "$@"
